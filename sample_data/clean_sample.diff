+++ b/backend/health.py
@@ -0,0 +1,12 @@
+from typing import Dict
+
+def get_system_status() -> Dict[str, str]:
+    """
+    Return current application status.
+    """
+    return {
+        "status": "healthy",
+        "version": "1.0.0",
+    }
+
